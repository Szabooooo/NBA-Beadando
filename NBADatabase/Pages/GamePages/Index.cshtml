@page
@model NBADatabase.Pages.GamePages.IndexModel

@{
    ViewData["Title"] = "Games";
}

<h1>Games</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Game[0].GameDate)</th>
            <th>@Html.DisplayNameFor(model => model.Game[0].HomeTeamId)</th>
            <th>Score</th>
            <th>@Html.DisplayNameFor(model => model.Game[0].AwayTeamId)</th>
            <th>@Html.DisplayNameFor(model => model.Game[0].Winner)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Game) {
        <tr>
            <td>@Html.DisplayFor(model => item.GameDate)</td>
            <td><a asp-page="/TeamPages/Details" asp-route-id="@item.HomeTeamId">@item.HomeTeam?.Name</a></td>
            <td>@item.HomePoints - @item.AwayPoints</td>
            <td><a asp-page="/TeamPages/Details" asp-route-id="@item.AwayTeamId">@item.AwayTeam?.Name</a></td>
            <td>@Html.DisplayFor(model => item.Winner)</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
