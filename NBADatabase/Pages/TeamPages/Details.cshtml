@page
@model NBADatabase.Pages.TeamPages.DetailsModel

@{
    ViewData["Title"] = "Team details";
}

<h1>@Model.Team.City @Model.Team.Name</h1>

<div>
    <h4>Team</h4>
    <hr />
    <partial name="_TeamDetails" model="Model.Team" />
</div>

<h4>Roster</h4>
<hr />
@if (Model.Team.Players.Count == 0)
{
    <p>No players yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>PPG</th>
                <th>RPG</th>
                <th>APG</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var player in Model.Team.Players)
        {
            <tr>
                <td><a asp-page="/PlayerPages/Details" asp-route-id="@player.Id">@player.Name</a></td>
                <td>@player.Ppg</td>
                <td>@player.Rpg</td>
                <td>@player.Apg</td>
            </tr>
        }
        </tbody>
    </table>
}
<p><a asp-page="/PlayerPages/Create">Add a player</a></p>

<h4>Games</h4>
<hr />
@if (Model.Games.Count == 0)
{
    <p>No games yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Home</th>
                <th>Score</th>
                <th>Away</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var game in Model.Games)
        {
            var won = game.HomeTeamId == Model.Team.Id
                ? game.HomePoints > game.AwayPoints
                : game.AwayPoints > game.HomePoints;
            <tr>
                <td><a asp-page="/GamePages/Details" asp-route-id="@game.Id">@game.GameDate</a></td>
                <td>@game.HomeTeam?.Name</td>
                <td>@game.HomePoints - @game.AwayPoints</td>
                <td>@game.AwayTeam?.Name</td>
                <td>@(won ? "W" : "L")</td>
            </tr>
        }
        </tbody>
    </table>
}

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Team.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
