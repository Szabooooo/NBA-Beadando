@page
@model NBADatabase.Pages.TeamPages.DeleteModel

@{
    ViewData["Title"] = "Delete team";
}

<h1>Delete</h1>

@if (Model.GameCount > 0)
{
    <div class="alert alert-warning">
        This team appears in @Model.GameCount game(s), so it can't be deleted.
        Delete those games first on the <a asp-page="./Details" asp-route-id="@Model.Team.Id">team's page</a>.
    </div>
}
else
{
    <h3>Are you sure you want to delete this?</h3>
    @if (Model.Team.Players.Count > 0)
    {
        <div class="alert alert-warning">
            Deleting this team also deletes its @Model.Team.Players.Count player(s):
            @string.Join(", ", Model.Team.Players.Select(p => p.Name)).
        </div>
    }
}

<div>
    <h4>Team</h4>
    <hr />
    <partial name="_TeamDetails" model="Model.Team" />

    <form method="post">
        <input type="hidden" asp-for="Team.Id" />
        @if (Model.GameCount == 0)
        {
            <input type="submit" value="Delete" class="btn btn-danger" /> <span>|</span>
        }
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
